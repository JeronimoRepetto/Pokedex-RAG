# The machine-level supply-chain defence (minimumReleaseAge=1440, i.e. packages must be
# at least 24h old) needs each package's publish `time`, which the ABBREVIATED registry
# metadata document omits — pnpm then fails closed with ERR_PNPM_MISSING_TIME.
# This tells pnpm the registry does serve the time field, so it fetches the full
# document and the age check actually runs. It ENABLES the check; it does not weaken it.
registry-supports-time-field=true
