# Copy to .env.local (gitignored) and adjust. Everything here is PUBLIC: NEXT_PUBLIC_*
# variables are inlined into the JavaScript bundle and readable by anyone using the app.

# Base URL of the Pokédex API. Must be an origin the API allows in CORS_ALLOWED_ORIGINS.
# Leave empty to call the same origin that serves this UI.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Highest ingested Pokémon id. A static export pre-renders one page per id, so this is
# a BUILD-time value: change it and rebuild after ingesting another generation.
NEXT_PUBLIC_POKEDEX_MAX_ID=151

# Only if the API runs with API_KEYS set. NOT a security control for a public
# deployment — the key ships to every browser. Fine for a local run or a shared demo.
NEXT_PUBLIC_API_KEY=
