# Copy to .env and fill in real values. NEVER commit .env.
# Keys are grouped by the component that reads them; new keys are added here the same
# milestone they start being read.

# --- Environment ---
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (docker-compose db service; used by data-pipeline and api) ---
# Host port 5433 by default: another PostgreSQL (e.g. inside WSL) commonly owns 5432.
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pokedex
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://pokedex:change-me@localhost:5433/pokedex

# --- Google Cloud (Vertex AI embeddings + Gemini; auth via ADC, no API key) ---
# Run once: gcloud auth application-default login
GCP_PROJECT_ID=pokedex-rag-504617
GCP_LOCATION=us-central1

# --- Embeddings (verified live 2026-08-05, ADR-0002) ---
# gemini-embedding-2 is served ONLY from the "global" location (404 in us-central1).
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_LOCATION=global
EMBEDDING_DIMENSIONS=768
EMBEDDING_SPACE_LABEL=gemini-embedding-2-768-v1

# --- Local embeddings (Phase 6.1: EmbeddingGemma baseline, text-only space) ---
# Runs on this machine via sentence-transformers: install the optional dependency
# group first (poetry install --with local) in api and/or data-pipeline. The model is
# gated on Hugging Face — accept its license and authenticate (hf auth login) before
# the first download. Empty label = the space is not registered in the API.
LOCAL_EMBEDDING_MODEL=google/embeddinggemma-300m
LOCAL_EMBEDDING_DIMENSIONS=768
LOCAL_EMBEDDING_SPACE_LABEL=embeddinggemma-768-v1

# --- Generation (Phase 3+; both verified live 2026-08-05) ---
# gemini-3.6-flash serves from "global" only; gemini-2.5-flash serves from us-central1.
GENERATION_MODEL=gemini-3.6-flash
GENERATION_LOCATION=global

# --- Data pipeline ---
# Where snapshots and sprites are written (gitignored). Absolute path recommended.
DATA_DIR=./data
# PokéAPI fair use: requests/second and bounded retry attempts (transient errors only).
POKEAPI_RATE_LIMIT_PER_SEC=3.0
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_ATTEMPTS=4

# --- Langfuse (cloud.langfuse.com; Phase 3+) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- LLM provider selection (Phase 4+) ---
# Must match a name registered in api/main.py's ProviderRegistry; unregistered names
# abort at startup.
LLM_PRIMARY=vertex-gemini
LLM_FALLBACK=ai-studio-gemini

# --- Google AI Studio (Phase 4.2: second provider, verified live 2026-08-06) ---
# API key auth (not ADC) — create at https://aistudio.google.com/apikey. Gemma has no
# paid tier at all; gemini-3.5-flash-lite does but is cheap ($0.30/$2.50 per 1M tokens).
AI_STUDIO_API_KEY=
AI_STUDIO_MODEL=gemini-3.5-flash-lite

# --- Evals (Phase 5+; apps/evals only) ---
API_BASE_URL=http://localhost:8000
CASES_DIR=cases

# --- Report cost table (Phase 6.4; apps/evals only) ---
# JSON keyed by model name. Models absent from this table are reported as "cost
# unknown" instead of guessed — check the provider's pricing page before editing.
MODEL_PRICING_JSON={"gemini-3.6-flash":{"input_per_1m":0.30,"output_per_1m":2.50},"gemini-3.5-flash-lite":{"input_per_1m":0.30,"output_per_1m":2.50}}

# --- API access gate (Phase 6.6; apps/api only) ---
# Comma-separated shared keys sent as the X-API-Key header. EMPTY = GATE DISABLED,
# which is fine locally and unacceptable in a deployment. /health stays public so the
# platform health check keeps working. Generate with: openssl rand -hex 32
API_KEYS=

# --- LLM judge (Phase 5.5) ---
# Empty disables judging entirely. Must differ from LLM_PRIMARY — a model must not
# grade its own answers — enforced at startup, not left to configuration discipline.
JUDGE_PROVIDER=ai-studio-gemini
MAX_REFORMULATE_ATTEMPTS=2
