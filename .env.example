# Copy to .env and fill in real values. NEVER commit .env.
# Keys are grouped by the component that reads them; new keys are added here the same
# milestone they start being read.

# --- Environment ---
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (docker-compose db service; used by data-pipeline and api) ---
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pokedex
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pokedex:change-me@localhost:5432/pokedex

# --- Google Cloud (Vertex AI embeddings + Gemini; auth via ADC, no API key) ---
# Run once: gcloud auth application-default login
GCP_PROJECT_ID=pokedex-rag-504617
GCP_LOCATION=us-central1

# --- Embeddings (values verified live in milestone 0.6 / ADR-0002) ---
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_SPACE_LABEL=gemini-embedding-2-768-v1

# --- Langfuse (cloud.langfuse.com; Phase 3+) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
